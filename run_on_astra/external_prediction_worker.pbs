#!/usr/bin/env bash
#PBS -q gpuq
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=96:00:00
set -euo pipefail

project_root="/home/swaminathanj/research_artifacts/SART"
cd "${project_root}"
: "${SART_CHECKPOINT:?qsub must set SART_CHECKPOINT}"
: "${SART_BENCHMARK:?qsub must set SART_BENCHMARK}"
: "${SART_SPLIT:?qsub must set SART_SPLIT}"
: "${SART_CACHE_ROOT:?qsub must set SART_CACHE_ROOT}"
: "${SART_PROTOCOL:?qsub must set SART_PROTOCOL}"
: "${SART_OUTPUT_ROOT:?qsub must set SART_OUTPUT_ROOT}"
: "${SART_PREDICTION_KEY:?qsub must set SART_PREDICTION_KEY}"
: "${SART_ATTEMPT:?qsub must set SART_ATTEMPT}"
: "${SART_INITIAL_KEY:?qsub must set SART_INITIAL_KEY}"
printf 'run_source_sha256='
sha256sum scripts/evaluate/generate_external_predictions.py
sha256sum scripts/evaluate/run_external_prediction_batch.py
export PATH="${project_root}/env/bin:${PATH}"
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1

# Use the same physical-GPU lock as training and calibration workers.
lock_dir="/tmp/sart_gpu_locks_${USER}"
mkdir -p "${lock_dir}"
selected_gpu=""
for attempt in $(seq 1 180); do
  while IFS=',' read -r gpu_id free_mib; do
    gpu_id="${gpu_id//[[:space:]]/}"
    free_mib="${free_mib//[[:space:]]/}"
    [[ "${gpu_id}" =~ ^[0-9]+$ && "${free_mib}" =~ ^[0-9]+$ ]] || continue
    (( free_mib >= 30000 )) || continue
    eval "exec {gpu_lock_fd}>\"${lock_dir}/gpu_${gpu_id}.lock\""
    if flock -n "${gpu_lock_fd}"; then
      selected_gpu="${gpu_id}"
      break
    fi
    eval "exec ${gpu_lock_fd}>&-"
  done < <(nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits | sort -t, -k2,2nr)
  [[ -n "${selected_gpu}" ]] && break
  sleep 10
done
if [[ -z "${selected_gpu}" ]]; then
  echo "No unclaimed A100 with at least 30 GiB free after 30 minutes" >&2
  exit 75
fi
export CUDA_VISIBLE_DEVICES="${selected_gpu}"
printf '%s,%s,%s,%s\n' "${PBS_JOBID}" "$(hostname)" "${selected_gpu}" "${SART_PREDICTION_KEY}" \
  >>"${lock_dir}/allocation_ledger.csv"

export SART_ENVIRONMENT_DIR="experiments/${SART_PREDICTION_KEY}/attempts/${SART_ATTEMPT}/environment"
bash scripts/reproduce/capture_environment.sh "${SART_PREDICTION_KEY}_attempt${SART_ATTEMPT}"
env/bin/python scripts/evaluate/run_external_prediction_batch.py
