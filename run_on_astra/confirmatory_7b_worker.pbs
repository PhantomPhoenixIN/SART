#!/usr/bin/env bash
#PBS -q gpuq
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=96:00:00
set -euo pipefail

project_root="/home/swaminathanj/research_artifacts/SART"
cd "${project_root}"
: "${SART_CONFIG:?qsub must set SART_CONFIG}"
: "${SART_RUN_ID:?qsub must set SART_RUN_ID}"
: "${SART_ATTEMPT:?qsub must set SART_ATTEMPT}"
printf 'run_source_sha256='
sha256sum src/training/run_translation.py
export PATH="${project_root}/env/bin:${PATH}"
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=1
export SART_NUM_WORKERS="${SART_NUM_WORKERS:-2}"

# PBS allocates an ngpus resource but this cluster does not set CUDA_VISIBLE_DEVICES.
# Lock and select a physical GPU with enough free memory so concurrent PBS jobs on the
# same node never all fall back to cuda:0.
lock_dir="/tmp/sart_gpu_locks_${USER}"
mkdir -p "${lock_dir}"
selected_gpu=""
for attempt in $(seq 1 180); do
  while IFS=',' read -r gpu_id free_mib; do
    gpu_id="${gpu_id//[[:space:]]/}"
    free_mib="${free_mib//[[:space:]]/}"
    [[ "${gpu_id}" =~ ^[0-9]+$ && "${free_mib}" =~ ^[0-9]+$ ]] || continue
    (( free_mib >= 30000 )) || continue
    eval "exec {gpu_lock_fd}>\"${lock_dir}/gpu_${gpu_id}.lock\""
    if flock -n "${gpu_lock_fd}"; then
      selected_gpu="${gpu_id}"
      break
    fi
    eval "exec ${gpu_lock_fd}>&-"
  done < <(nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits | sort -t, -k2,2nr)
  [[ -n "${selected_gpu}" ]] && break
  sleep 10
done
if [[ -z "${selected_gpu}" ]]; then
  echo "No unclaimed A100 with at least 30 GiB free after 30 minutes" >&2
  exit 75
fi
export CUDA_VISIBLE_DEVICES="${selected_gpu}"
printf '%s,%s,%s\n' "${PBS_JOBID}" "$(hostname)" "${selected_gpu}" \
  >>"${lock_dir}/allocation_ledger.csv"

export SART_ENVIRONMENT_DIR="experiments/${SART_RUN_ID}/attempts/${SART_ATTEMPT}/environment"
bash scripts/reproduce/capture_environment.sh "${SART_RUN_ID}_attempt${SART_ATTEMPT}"
env/bin/python src/training/run_translation.py --config "${SART_CONFIG}"
