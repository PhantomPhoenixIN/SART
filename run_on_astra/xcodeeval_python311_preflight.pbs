#!/bin/bash
#PBS -N sart_xcodeeval_py311
#PBS -q cpuq
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=96:00:00
#PBS -W depend=afterany:25579.hn01
#PBS -j oe
set -euo pipefail
cd /home/swaminathanj/research_artifacts/SART
export PATH="/apps/apps/gcc/gcc-12.3.0/gc/bin:${PATH}"
export LD_LIBRARY_PATH="/apps/apps/gcc/gcc-12.3.0/gc/lib64:/apps/apps/gcc/gcc-12.3.0/gc/lib:${LD_LIBRARY_PATH:-}"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONPATH=/home/swaminathanj/research_artifacts/SART
exec env/bin/python scripts/evaluate/preflight_xcodeeval_py311.py \
  --manifest data/manifests/xcodeeval_reference_selection.json \
  --output outputs/xcodeeval_reference_preflight_py311 \
  --language Python --workers 6 --repeats 3 --case-timeout 6
